    { "source": "/api/:path*", "destination": "https://aideanc-production-84b5.up.railway.app/api/:path*" },
    { "source": "/storage/:path*", "destination": "https://aideanc-production-84b5.up.railway.app/storage/:path*" }
  ]
}
