<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a1a3f" />
    <title>Create account — AIDEA</title>

    <!-- Same saved / system theme logic as the admin dashboard -->
    <script>
        (function () {
            var t = null;
            try { t = localStorage.getItem('aidea_theme'); } catch (e) { }
            if (t !== 'light' && t !== 'dark') {
                t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet" />
    <link rel="stylesheet" href="register.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="../shared/logo-32.png" />
    <link rel="apple-touch-icon" href="../shared/logo-180.png" />
</head>

<body>
    <div class="auth-layout">

        <!-- LEFT: brand panel -->
        <aside class="auth-left">
            <div class="left-inner">
                <a class="brand" href="../landing/index.html" aria-label="AIDEA home">
                    <img src="../shared/logo-64.png" alt="" width="32" height="32" style="display:block;object-fit:contain">
                    <span class="brand-text">
                        <span class="brand-name">AIDEA</span>
                        <span class="brand-sub">Norzagaray College</span>
                    </span>
                </a>

                <div class="left-copy">
                    <h2>Join the research community</h2>
                    <p>Create one account for your thesis, your files, and your payments.</p>
                    <ul class="points">
                        <li><span class="pt-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" />
                                    <path d="M14 3v5h5M9 13h6M9 17h4" />
                                </svg></span>
                            <div><strong>Thesis management</strong><span>Submit and track your thesis</span></div>
                        </li>
                        <li><span class="pt-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path
                                        d="M4 5.5A1.5 1.5 0 0 1 5.5 4H11v16H5.5A1.5 1.5 0 0 0 4 21.5zM20 5.5A1.5 1.5 0 0 0 18.5 4H13v16h5.5a1.5 1.5 0 0 1 1.5 1.5z" />
                                </svg></span>
                            <div><strong>Research repository</strong><span>Browse all approved papers</span></div>
                        </li>
                        <li><span class="pt-icon" aria-hidden="true"><svg viewBox="0 0 24 24" width="18" height="18"
                                    fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                    stroke-linejoin="round">
                                    <path
                                        d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9zM19 16l.8 2.2L22 19l-2.2.8L19 22l-.8-2.2L16 19l2.2-.8z" />
                                </svg></span>
                            <div><strong>AI-powered services</strong><span>Plagiarism check and analysis</span></div>
                        </li>
                    </ul>
                </div>

                <p class="left-note">Your data is protected under Norzagaray College's data privacy policy.</p>
            </div>
        </aside>

        <!-- RIGHT: form -->
        <main class="auth-right">
            <button class="theme-btn" id="themeBtn" type="button" aria-label="Switch to dark mode" title="Toggle theme">
                <svg class="i-moon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
                </svg>
                <svg class="i-sun" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round">
                    <circle cx="12" cy="12" r="4" />
                    <path
                        d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                </svg>
            </button>

            <div class="card">
                <div class="form-header">
                    <h1>Create your account</h1>
                    <p>Your name, email, and a password.</p>
                </div>

                <form id="registerForm" novalidate>

                    <div class="row">
                        <div class="field">
                            <label for="fname">First name <span class="req">*</span></label>
                            <input type="text" id="fname" placeholder="Juan" autocomplete="given-name" />
                            <span class="field-error" id="errFname"></span>
                        </div>
                        <div class="field">
                            <label for="lname">Last name <span class="req">*</span></label>
                            <input type="text" id="lname" placeholder="Dela Cruz" autocomplete="family-name" />
                            <span class="field-error" id="errLname"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="field">
                            <label for="mi">Middle initial</label>
                            <input type="text" id="mi" placeholder="D." maxlength="5" />
                        </div>
                        <div class="field">
                            <label for="regEmail">Email address <span class="req">*</span></label>
                            <input type="email" id="regEmail" placeholder="you@example.com" autocomplete="email" />
                            <span class="field-error" id="errEmail"></span>
                        </div>
                    </div>

                    <div class="row">
                        <div class="field">
                            <label for="regPassword">Password <span class="req">*</span></label>
                            <div class="input-wrap">
                                <input type="password" id="regPassword" placeholder="Create a password"
                                    autocomplete="new-password" />
                                <button type="button" class="toggle-pass" data-target="regPassword"
                                    aria-label="Show password">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path
                                            d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                        <path
                                            d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                        <line x1="1" y1="1" x2="23" y2="23" />
                                    </svg>
                                </button>
                            </div>
                            <span class="field-error" id="errPassword"></span>
                        </div>

                        <div class="field">
                            <label for="regConfirmPass">Confirm password <span class="req">*</span></label>
                            <div class="input-wrap">
                                <input type="password" id="regConfirmPass" placeholder="Repeat password"
                                    autocomplete="new-password" />
                                <button type="button" class="toggle-pass" data-target="regConfirmPass"
                                    aria-label="Show password">
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z" />
                                        <circle cx="12" cy="12" r="3" />
                                    </svg>
                                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor"
                                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                        <path
                                            d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94" />
                                        <path
                                            d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19" />
                                        <line x1="1" y1="1" x2="23" y2="23" />
                                    </svg>
                                </button>
                            </div>
                            <span class="field-error" id="errConfirmPass"></span>
                        </div>
                    </div>

                    <div class="strength" id="strengthBox" aria-live="polite" hidden>
                        <div class="strength-top">
                            <div class="strength-bar">
                                <div class="strength-fill" id="strengthFill"></div>
                            </div>
                            <span class="strength-label" id="strengthLabel"></span>
                        </div>
                        <div class="hints">
                            <span class="hint" id="hint8char">At least 8 characters</span>
                            <span class="hint" id="hintUpper">One uppercase letter</span>
                            <span class="hint" id="hintNum">One number</span>
                            <span class="hint" id="hintSpecial">One special character (!@#$)</span>
                        </div>
                    </div>

                    <div class="field">
                        <label class="checkbox-label" for="agreeTerms">
                            <input type="checkbox" id="agreeTerms" />
                            <span>I agree to the <a href="#terms" class="link" data-legal="terms">Terms of Service</a>
                                and
                                <a href="#privacy" class="link" data-legal="privacy">Privacy Policy</a> of Norzagaray
                                College AIDEA.</span>
                        </label>
                        <span class="field-error" id="errTerms"></span>
                    </div>

                    <button type="submit" class="btn-submit" id="registerBtn">
                        <span id="regBtnText">Create account</span>
                        <span id="regBtnSpinner" class="spinner" hidden></span>
                    </button>
                </form>

                <div class="alt-action">
                    <span>Already have an account? <a href="../login/login.html" class="link">Sign in</a></span>
                    <a href="../landing/index.html" class="muted-link">Back to home</a>
                </div>
            </div>
        </main>
    </div>

    <!-- Terms / Privacy modal -->
    <div class="modal-backdrop" id="legalModal" hidden>
        <div class="modal modal-legal" role="dialog" aria-modal="true" aria-labelledby="legalTitle">
            <div class="legal-head">
                <h2 id="legalTitle">Terms and privacy</h2>
                <button type="button" class="legal-close" id="legalClose" aria-label="Close">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round">
                        <path d="M6 6l12 12M18 6L6 18" />
                    </svg>
                </button>
            </div>
            <div class="legal-tabs" role="tablist">
                <button type="button" role="tab" id="tabTerms" data-tab="terms" aria-selected="true">Terms of
                    Service</button>
                <button type="button" role="tab" id="tabPrivacy" data-tab="privacy" aria-selected="false">Privacy
                    Policy</button>
            </div>

            <div class="legal-body" id="legalBody" tabindex="0">
                <section id="panelTerms" role="tabpanel" aria-labelledby="tabTerms">
                    <p class="legal-meta">Applies to all users of AIDEA — Research Services Availment &amp; Repository,
                        Norzagaray College.</p>

                    <h3>1. Acceptance of terms</h3>
                    <p>By creating an account or using AIDEA, you agree to these Terms of Service and the Privacy
                        Policy. If you do not agree, do not register or use the system.</p>

                    <h3>2. Eligibility and your account</h3>
                    <ul>
                        <li>AIDEA is for students, faculty, and staff of Norzagaray College and authorized users.</li>
                        <li>Provide accurate information when you register, and keep it up to date.</li>
                        <li>Keep your password confidential. You are responsible for all activity under your account.
                        </li>
                        <li>Tell the administrator right away if you suspect unauthorized access.</li>
                    </ul>

                    <h3>3. Services provided</h3>
                    <p>AIDEA lets you submit and track thesis documents, request research services (such as plagiarism
                        checks, statistical analysis, and formatting), browse the approved-thesis repository, and pay
                        for services. Available services and their prices are listed under Services &amp; Pricing and
                        may change.</p>

                    <h3>4. Academic integrity</h3>
                    <ul>
                        <li>Submit only work that is your own or that you are authorized to submit.</li>
                        <li>Do not plagiarize, fabricate data, or submit work created by someone else as your own.</li>
                        <li>Results from AI-assisted tools, including plagiarism and similarity scores, are guides only.
                            Final academic decisions rest with the college and your adviser.</li>
                    </ul>

                    <h3>5. Your content and ownership</h3>
                    <p>You keep ownership of the files and thesis content you submit. You give Norzagaray College
                        permission to store, process, review, and, once approved, display your thesis in the repository
                        according to college policy.</p>

                    <h3>6. Payments</h3>
                    <ul>
                        <li>Paid services are settled through the payment methods shown in the system, such as GCash.
                        </li>
                        <li>You must enter a valid payment reference. Payments are verified by the administrator before
                            a service is completed.</li>
                        <li>Refunds and cancellations follow the college's policy for the specific service.</li>
                    </ul>

                    <h3>7. Acceptable use</h3>
                    <ul>
                        <li>Do not upload malware, unlawful, or offensive material.</li>
                        <li>Do not attempt to break into, overload, or disrupt the system or other users' accounts.</li>
                        <li>Do not share or resell repository content beyond what college policy allows.</li>
                    </ul>

                    <h3>8. Availability and changes</h3>
                    <p>We work to keep AIDEA available, but we do not guarantee uninterrupted access. Features, prices,
                        and these terms may be updated. Continued use after an update means you accept the new version.
                    </p>

                    <h3>9. Suspension and termination</h3>
                    <p>The college may suspend or close accounts that violate these terms, the college's academic
                        policies, or applicable law.</p>

                    <h3>10. Limitation of liability</h3>
                    <p>AIDEA is provided "as is". To the extent allowed by law, the college is not liable for indirect
                        losses, lost data, or missed deadlines caused by system downtime or by information you provided
                        incorrectly. Keep your own copies of your files.</p>

                    <h3>11. Contact</h3>
                    <p>For questions about these terms, contact the AIDEA administrator at Norzagaray College.</p>
                </section>

                <section id="panelPrivacy" role="tabpanel" aria-labelledby="tabPrivacy" hidden>
                    <p class="legal-meta">How Norzagaray College AIDEA handles your personal data, in line with the Data
                        Privacy Act of 2012 (Republic Act No. 10173).</p>

                    <h3>1. Information we collect</h3>
                    <ul>
                        <li><strong>Account details:</strong> first name, last name, middle initial, email address, and
                            an encrypted password.</li>
                        <li><strong>Academic content:</strong> thesis titles, documents, and files you submit or request
                            services for.</li>
                        <li><strong>Payment details:</strong> service, amount, payment method, and GCash reference
                            number. We do not store your GCash PIN or wallet credentials.</li>
                        <li><strong>Usage data:</strong> sign-in activity, submission status, feedback ratings, and
                            basic device or browser information.</li>
                    </ul>

                    <h3>2. Why we use it</h3>
                    <ul>
                        <li>To create and secure your account and verify your email.</li>
                        <li>To process thesis submissions, requested services, and payments.</li>
                        <li>To send status updates and system notices.</li>
                        <li>To run plagiarism and analysis tools, and to maintain the approved-thesis repository.</li>
                        <li>To improve the system, prevent misuse, and prepare college reports.</li>
                    </ul>

                    <h3>3. Who can see it</h3>
                    <p>Your data is available to you and to authorized college administrators and staff who need it for
                        their work. Approved theses may be visible in the repository according to college policy. We do
                        not sell your personal data. We share it with outside parties only when required by law or with
                        your consent.</p>

                    <h3>4. AI-assisted tools</h3>
                    <p>Documents you submit for AI-assisted checks are used to produce your results and are not used to
                        advertise to you. Avoid uploading files with information you do not want processed.</p>

                    <h3>5. Storage, security, and retention</h3>
                    <p>We use reasonable technical and organizational measures to protect your data, including password
                        hashing and access controls. No system is completely secure. We keep your data only as long as
                        needed for academic, administrative, and legal purposes, then delete or anonymize it.</p>

                    <h3>6. Your rights</h3>
                    <p>Under the Data Privacy Act, you may ask to be informed about how your data is used, access it,
                        correct it, object to certain uses, request its deletion or blocking, and file a complaint with
                        the National Privacy Commission. To make a request, contact the AIDEA administrator.</p>

                    <h3>7. Cookies and local storage</h3>
                    <p>AIDEA stores small pieces of data in your browser, such as your sign-in session and theme
                        preference, so the system works as expected. It is not used for advertising.</p>

                    <h3>8. Changes to this policy</h3>
                    <p>We may update this policy. Significant changes will be shown in the system.</p>
                </section>
            </div>

            <div class="legal-actions">
                <button type="button" class="btn-ghost" id="legalCancel">Close</button>
                <button type="button" class="btn-submit" id="legalAgree">I agree</button>
            </div>
        </div>
    </div>

    <!-- Success modal -->
    <div class="modal-backdrop" id="successOverlay" hidden>
        <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="successTitle"
            aria-describedby="successDesc">
            <div class="modal-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2.4"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M5 12.5l4.5 4.5L19 7.5" />
                </svg>
            </div>
            <h2 id="successTitle">Account created</h2>
            <p id="successDesc">We sent a verification email to your address. Verify it to start using AIDEA.</p>
            <a href="../login/login.html" class="btn-submit">Go to sign in</a>
        </div>
    </div>

    <div id="toastWrap" aria-live="polite"></div>

    <script src="register.js"></script>
</body>

</html>