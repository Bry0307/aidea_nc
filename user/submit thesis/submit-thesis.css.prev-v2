/* ==========================================================================
   AIDEA Student — Submit Thesis
   Page-specific styles only. The shell (tokens, sidebar, topbar, modal, panel,
   dark mode) comes from ../dashboard/dashboard.css, loaded first in the HTML.
   ========================================================================== */

.btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 40px;
    padding: 0 16px;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 10px;
    font-size: 13.5px;
    font-weight: 600;
    cursor: pointer;
    transition: background-color .15s;
}

.btn-secondary:hover {
    background: var(--hover);
}

.btn-primary {
    border: 0;
    cursor: pointer;
}

.btn-primary:disabled {
    opacity: .6;
    cursor: progress;
    filter: none;
}

.submit-layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 320px;
    gap: 16px;
    align-items: start;
}

.info-col {
    display: flex;
    flex-direction: column;
    gap: 16px;
}

/* ── Form ── */
form {
    display: flex;
    flex-direction: column;
    gap: 18px;
}

.form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
}

.field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    min-width: 0;
}

.field>label,
.field>.label {
    font-size: 13px;
    font-weight: 600;
}

.req {
    color: var(--bad-fg);
}

.opt {
    color: var(--muted);
    font-weight: 500;
}

.field input,
.field select,
.field textarea {
    width: 100%;
    padding: 10px 14px;
    font: inherit;
    font-size: 14px;
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    transition: border-color .15s, box-shadow .15s;
}

.field textarea {
    resize: vertical;
    min-height: 130px;
}

.field input::placeholder,
.field textarea::placeholder {
    color: var(--muted);
    opacity: .8;
}

.field input:focus,
.field select:focus,
.field textarea:focus {
    outline: none;
    border-color: var(--primary);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--primary) 22%, transparent);
}

.field .invalid {
    border-color: var(--bad-fg);
}

.field-hint {
    color: var(--muted);
    font-size: 12.5px;
}

/* ── File drop ── */
.file-drop {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 28px 16px;
    text-align: center;
    cursor: pointer;
    background: var(--surface-2);
    border: 1.5px dashed var(--border);
    border-radius: 12px;
    transition: border-color .15s, background-color .15s;
}

.file-drop:hover,
.file-drop.dragover {
    border-color: var(--primary);
    background: var(--blue-soft);
}

.file-drop svg {
    color: var(--primary);
    margin-bottom: 4px;
}

.file-drop strong {
    font-size: 14px;
    font-weight: 600;
}

.file-drop span {
    color: var(--muted);
    font-size: 12.5px;
}

.file-preview {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    background: var(--blue-soft);
    border-radius: var(--radius-sm);
    font-size: 13.5px;
}

.file-preview[hidden] {
    display: none;
}

.file-name {
    font-weight: 600;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.file-size {
    color: var(--muted);
    font-size: 12.5px;
    white-space: nowrap;
}

.file-remove {
    margin-left: auto;
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    background: transparent;
    border: 0;
    border-radius: 8px;
    color: var(--muted);
    cursor: pointer;
}

.file-remove:hover {
    background: var(--hover);
    color: var(--text);
}

.form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 10px;
    margin-top: 4px;
}

/* ── Side cards ── */
.guide-list {
    padding-left: 18px;
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: var(--muted);
    font-size: 13px;
}

.steps {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 14px;
}

.steps li {
    display: flex;
    gap: 12px;
    align-items: flex-start;
}

.step-num {
    width: 26px;
    height: 26px;
    flex-shrink: 0;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: #0a1a3f;
    font-size: 12.5px;
    font-weight: 800;
}

.steps strong {
    display: block;
    font-size: 13.5px;
    font-weight: 600;
}

.steps p {
    margin-top: 1px;
    color: var(--muted);
    font-size: 12.5px;
}

/* ── Toast ── */
.toast-stack {
    position: fixed;
    z-index: 400;
    right: max(20px, env(safe-area-inset-right, 0px));
    bottom: calc(20px + env(safe-area-inset-bottom, 0px));
    display: flex;
    flex-direction: column;
    gap: 8px;
    max-width: min(380px, calc(100vw - 40px));
}

.toast {
    padding: 12px 18px;
    border-radius: 10px;
    background: #14764a;
    color: #fff;
    font-size: 13.5px;
    font-weight: 600;
    white-space: pre-line;
    box-shadow: 0 10px 30px -8px rgba(0, 0, 0, .4);
    animation: menuPop .18s ease both;
}

.toast-error {
    background: #dc2626;
}

@media (max-width: 1200px) {
    .submit-layout {
        grid-template-columns: 1fr;
    }
}

@media (max-width: 720px) {
    .form-row {
        grid-template-columns: 1fr;
    }

    .panel-head:has(.btn-secondary) {
        flex-direction: column;
        align-items: stretch;
    }

    .panel-head .btn-secondary {
        justify-content: center;
    }
}

@media (max-width: 420px) {
    .form-actions {
        flex-direction: column-reverse;
    }

    .form-actions>* {
        width: 100%;
        justify-content: center;
    }
}

/* SUBMIT-FORM-V2 */
#thesisTitle { resize: vertical; min-height: 64px; font: inherit; }
.mode-toggle { display: flex; gap: 12px; flex-wrap: wrap; margin: 6px 0 12px; }
.mode-opt { display: inline-flex; align-items: center; gap: 8px; padding: 10px 14px; border: 1px solid rgba(128,128,128,.4); border-radius: 10px; cursor: pointer; font-weight: 600; font-size: 14px; }
.mode-opt:has(input:checked) { border-color: #3b82f6; background: rgba(59,130,246,.12); }
.mode-opt input { accent-color: #3b82f6; }
#abstractFile, #imradFile { width: 100%; padding: 12px; border: 1px dashed rgba(128,128,128,.5); border-radius: 10px; background: transparent; color: inherit; font: inherit; box-sizing: border-box; }
.field-hint.count-ok { color: #22c55e; }
.field-hint.count-bad { color: #ef4444; }
#abstractTextWrap[hidden], #abstractFileWrap[hidden], #imradReq[hidden], #imradOpt[hidden] { display: none !important; }

/* UI-FIX-V2: underline tabs for abstract mode, badge counter, upload boxes */
.mode-toggle { display: flex; gap: 28px; flex-wrap: nowrap; margin: 6px 0 14px; padding: 0; border: 0; border-bottom: 1px solid rgba(128,128,128,.3); border-radius: 0; background: transparent; }
.mode-opt { position: relative; display: inline-flex; align-items: center; padding: 10px 2px; margin: 0 0 -1px; border: 0; border-bottom: 2px solid transparent; border-radius: 0; background: transparent; box-shadow: none; color: inherit; font-size: 13px; font-weight: 600; white-space: nowrap; opacity: .6; cursor: pointer; width: auto; height: auto; transition: opacity .15s, color .15s, border-color .15s; }
.mode-opt:hover { opacity: 1; }
.mode-opt input { position: absolute; opacity: 0; width: 0; height: 0; pointer-events: none; }
.mode-opt:has(input:checked) { opacity: 1; color: #3b82f6; border-bottom-color: #3b82f6; }
.mode-opt:has(input:focus-visible) { outline: 2px solid #3b82f6; outline-offset: 2px; border-radius: 4px; }

#thesisAbstract { width: 100%; box-sizing: border-box; padding: 14px 16px; border-radius: 12px; line-height: 1.55; resize: vertical; }
#abstractCount { display: block; width: fit-content; margin: 10px 0 0 auto; padding: 4px 12px; border-radius: 999px; background: rgba(128,128,128,.14); font-size: 12px; font-weight: 600; }
#abstractCount.count-ok { background: rgba(34,197,94,.16); color: #22c55e; }
#abstractCount.count-bad { background: rgba(245,158,11,.16); color: #f59e0b; }

#abstractFile, #imradFile { width: 100%; box-sizing: border-box; padding: 22px 16px; border: 1.5px dashed rgba(128,128,128,.5); border-radius: 12px; background: transparent; color: inherit; font: inherit; font-size: 13px; cursor: pointer; transition: border-color .15s, background .15s; }
#abstractFile:hover, #imradFile:hover { border-color: #3b82f6; background: rgba(59,130,246,.06); }
#abstractFile::file-selector-button, #imradFile::file-selector-button { margin-right: 14px; padding: 8px 16px; border: 0; border-radius: 8px; background: #3b82f6; color: #fff; font: inherit; font-weight: 600; cursor: pointer; }
#abstractFile::file-selector-button:hover, #imradFile::file-selector-button:hover { background: #2563eb; }