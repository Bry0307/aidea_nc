<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#0a1a3f" />
    <meta name="csrf-token" content="{{ csrf_token() }}" />
    <title>Submit Documents — AIDEA</title>

    <!-- Apply saved / system theme BEFORE paint (same student-side key as the dashboard) -->
    <script>
        (function () {
            var t = null;
            try { t = localStorage.getItem('aidea_user_theme'); } catch (e) { }
            if (t !== 'light' && t !== 'dark') {
                t = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.setAttribute('data-theme', t);
        })();
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
        rel="stylesheet" />
    <!-- Shared shell first, then this page's styles -->
    <link rel="stylesheet" href="../../user/dashboard/dashboard.css" />
    <link rel="stylesheet" href="../../user/submit thesis/submit-thesis.css" />
    <link rel="icon" type="image/png" sizes="32x32" href="../shared/logo-32.png" />
    <link rel="apple-touch-icon" href="../shared/logo-180.png" />
</head>

<body>

    <!-- SIDEBAR -->
    <aside class="sidebar" id="sidebar" aria-label="Main navigation">
        <a class="sidebar-brand" href="librarian_dashboard.html" aria-label="AIDEA home">
            <span class="brand-mark" aria-hidden="true"><img src="../shared/logo-64.png" alt="" width="32" height="32" style="display:block;object-fit:contain"></span>
            <span class="brand-text">
                <span class="brand-name">AIDEA</span>
                <span class="brand-sub">Norzagaray College</span>
            </span>
        </a>

        <div class="sidebar-scroll">
            <p class="nav-heading">Overview</p>
            <nav class="nav-group">
                <a href="librarian_dashboard.html">Dashboard</a>
            </nav>

            <p class="nav-heading">Main</p>
            <nav class="nav-group">
                <a href="librarian_submit.html" class="active" aria-current="page">Submit Documents</a>
            </nav>

            <p class="nav-heading">Services</p>
            <nav class="nav-group">
            </nav>

            <p class="nav-heading">Feedback</p>
            <nav class="nav-group">
            </nav>
        </div>

        <div class="sidebar-footer">
            <div class="profile-menu" id="profileMenu" role="menu" aria-label="Account" hidden>
                <a class="profile-menu-item" href="../profile/my-profile.html" role="menuitem">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <circle cx="12" cy="8" r="4" />
                        <path d="M4 21a8 8 0 0 1 16 0" />
                    </svg>
                    My profile
                </a>
                <button class="profile-menu-item danger" id="signOutBtn" type="button" role="menuitem">
                    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                        <path d="M16 17l5-5-5-5M21 12H9" />
                    </svg>
                    Sign out
                </button>
            </div>

            <button class="profile-btn" id="profileBtn" type="button" aria-haspopup="menu" aria-expanded="false"
                aria-controls="profileMenu">
                <div class="footer-avatar" aria-hidden="true">ST</div>
                <div class="footer-info">
                    <div class="footer-name">Librarian</div>
                    <div class="footer-role">Librarian</div>
                </div>
                <svg class="profile-chevron" viewBox="0 0 24 24" width="16" height="16" fill="none"
                    stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
                    aria-hidden="true">
                    <path d="M6 15l6-6 6 6" />
                </svg>
            </button>
        </div>
    </aside>

    <div class="scrim" id="scrim" hidden></div>

    <!-- MAIN -->
    <div class="main">
        <header class="topbar">
            <div class="topbar-left">
                <button class="icon-btn menu-btn" id="menuBtn" type="button" aria-label="Open menu"
                    aria-controls="sidebar" aria-expanded="false">
                    <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2"
                        stroke-linecap="round">
                        <path d="M4 7h16M4 12h16M4 17h10" />
                    </svg>
                </button>
                <div class="page-title">
                    <h1>Submit Documents <span class="badge-role">Librarian</span></h1>
                    <p>Fill out the form to submit your research paper</p>
                </div>
            </div>
            <div class="topbar-right">
                <span class="status-chip">Online</span>
                <button class="icon-btn" id="themeBtn" type="button" aria-label="Switch to dark mode"
                    title="Toggle theme">
                    <svg class="i-moon" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5Z" />
                    </svg>
                    <svg class="i-sun" viewBox="0 0 24 24" width="19" height="19" fill="none" stroke="currentColor"
                        stroke-width="2" stroke-linecap="round">
                        <circle cx="12" cy="12" r="4" />
                        <path
                            d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                    </svg>
                </button>
            </div>
        </header>

        <main class="content">
            <div class="submit-layout">

                <!-- FORM -->
                <section class="panel">
                    <div class="panel-head">
                        <div>
                            <h3 class="panel-title">Document Information</h3>
                            <p class="panel-sub">Fields marked <span class="req">*</span> are required</p>
                        </div>
                        <button class="btn-secondary" id="checkFormatBtn" type="button">Check formatting</button>
                    </div>

                    <form id="thesisForm" novalidate>
                        <div class="field">
                            <label for="thesisTitle">Thesis title <span class="req">*</span></label>
                            <textarea id="thesisTitle" rows="2" placeholder="Enter the full thesis title" required></textarea>
                        </div>

                        <div class="form-row">
                            <div class="field">
                                <label for="thesisCourse">Course / program <span class="req">*</span></label>
                                <select id="thesisCourse" required>
                                    <option value="">Select course</option>
                                    <option value="BSCS">BSCS</option>
                                    <option value="BEED">BEED</option>
                                    <option value="BSED">BSED</option>
                                    <option value="BSHM">BSHM</option>
                                </select>
                            </div>
                            <div class="field">
                                <label for="thesisYear">Academic year <span class="req">*</span></label>
                                <select id="thesisYear" required>
                                    <option value="">Select academic year</option>
                                    <option value="2026-2027">2026-2027</option>
                                    <option value="2027-2028">2027-2028</option>
                                    <option value="2028-2029">2028-2029</option>
                                    <option value="2029-2030">2029-2030</option>
                                </select>
                            </div>
                        </div>

                        <div class="field">
                            <span class="label" id="abstractLabel">Abstract / summary <span class="req">*</span></span>
                            <div class="mode-toggle" role="radiogroup" aria-labelledby="abstractLabel">
                                <label class="mode-opt"><input type="radio" name="abstractMode" value="text" checked /> Type text</label>
                                <label class="mode-opt"><input type="radio" name="abstractMode" value="file" /> Upload file (PDF / DOCX)</label>
                            </div>
                            <div id="abstractTextWrap">
                                <textarea id="thesisAbstract" rows="6" placeholder="Write your abstract (150 to 200 words)"></textarea>
                                <span class="field-hint" id="abstractCount">0 words - required: 150 to 200 words</span>
                            </div>
                            <div id="abstractFileWrap" hidden>
                                <input type="file" id="abstractFile" accept=".pdf,.docx" />
                                <span class="field-hint">PDF or DOCX, up to 20 MB</span>
                            </div>
                        </div>

                        <div class="field">
                            <span class="label" id="imradLabel">IMRAD file <span class="req" id="imradReq" hidden>*</span><span class="opt" id="imradOpt">(optional)</span></span>
                            <input type="file" id="imradFile" accept=".pdf,.docx" aria-labelledby="imradLabel" />
                            <span class="field-hint">PDF or DOCX, up to 20 MB</span>
                        </div>

                        <div class="form-row">
                            <div class="field">
                                <label for="adviserName">Adviser name <span class="req">*</span></label>
                                <input type="text" id="adviserName" placeholder="Full name of your adviser" required />
                            </div>
                            <div class="field">
                                <label for="submissionType">Submission type <span class="req">*</span></label>
                                <select id="submissionType" required>
                                    <option value="thesis">Thesis paper</option>
                                    <option value="research">Research paper</option>
                                </select>
                            </div>
                        </div>

                        <div class="field">
                            <label for="authors">Researchers <span class="opt">(optional)</span></label>
                            <textarea id="authors" rows="3" placeholder="One name per line. Press Enter for the next name."></textarea>
                        </div>

                        <div class="field">
                            <span class="label" id="fileLabel"><span id="fileLabelText">Thesis paper file</span> <span class="req">*</span></span>
                            <div class="file-drop" id="fileDrop" role="button" tabindex="0" aria-labelledby="fileLabel">
                                <svg viewBox="0 0 24 24" width="28" height="28" fill="none" stroke="currentColor"
                                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                    <path d="M12 16V4M7 9l5-5 5 5" />
                                    <path d="M4 16v3a1 1 0 0 0 1 1h14a1 1 0 0 0 1-1v-3" />
                                </svg>
                                <strong>Drag and drop your file here, or click to browse</strong>
                                <span>PDF or DOCX, up to 20 MB</span>
                            </div>
                            <input type="file" id="fileInput" accept=".pdf,.docx" hidden />
                            <div id="filePreview" class="file-preview" hidden></div>
                        </div>


                        <div class="form-actions">
                            <button type="button" class="btn-secondary" id="resetBtn">Reset</button>
                            <button type="submit" class="btn-primary" id="submitBtn">Submit thesis</button>
                        </div>
                    </form>
                </section>

                <!-- GUIDELINES + STEPS -->
                <div class="info-col">
                    <section class="panel">
                        <div class="panel-head">
                            <h3 class="panel-title">Submission guidelines</h3>
                        </div>
                        <ul class="guide-list">
                            <li>File must be a PDF or DOCX</li>
                            <li>Maximum file size is 20 MB</li>
                            <li>Title must match your approved proposal</li>
                            <li>Abstract must be 150 to 200 words</li>
                            <li>Include all researchers</li>
                        </ul>
                    </section>

                    <section class="panel">
                        <div class="panel-head">
                            <h3 class="panel-title">What happens next</h3>
                        </div>
                        <ol class="steps">
                            <li><span class="step-num">1</span>
                                <div><strong>Fill the form</strong>
                                    <p>Complete all required fields</p>
                                </div>
                            </li>
                            <li><span class="step-num">2</span>
                                <div><strong>Upload your file</strong>
                                    <p>Attach your thesis document</p>
                                </div>
                            </li>
                            <li><span class="step-num">3</span>
                                <div><strong>Submit</strong>
                                    <p>Select Submit thesis</p>
                                </div>
                            </li>
                            <li><span class="step-num">4</span>
                                <div><strong>Wait for review</strong>
                                    <p>You'll be notified of the status</p>
                                </div>
                            </li>
                        </ol>
                    </section>
                </div>

            </div>
        </main>
    </div>

    <div class="toast-stack" id="toastStack" role="status" aria-live="polite"></div>

    <!-- SIGN OUT CONFIRMATION MODAL -->
    <div class="modal-backdrop" id="signOutModal" hidden>
        <div class="modal" role="alertdialog" aria-modal="true" aria-labelledby="signOutTitle"
            aria-describedby="signOutDesc">
            <div class="modal-icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2"
                    stroke-linecap="round" stroke-linejoin="round">
                    <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4" />
                    <path d="M16 17l5-5-5-5M21 12H9" />
                </svg>
            </div>
            <h3 class="modal-title" id="signOutTitle">Sign out?</h3>
            <p class="modal-text" id="signOutDesc">You will need to log in again to access your account.</p>
            <div class="modal-actions">
                <button class="modal-btn modal-btn-cancel" id="signOutCancel" type="button">Cancel</button>
                <button class="modal-btn modal-btn-danger" id="signOutConfirm" type="button">Sign out</button>
            </div>
        </div>
    </div>

    <script src="../../user/login/login.js"></script>
    <script src="../formatting/testvalidator.js"></script>
    <script src="librarian_submit.js"></script>
<script src="../../user/shared/sidebar-avatar.js"></script>
<script src="../../user/shared/sidebar_toggle.js"></script>
</body>

</html>